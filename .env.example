# Copy this file to .env and adjust. .env is never committed.

BASE_URL=https://credentialsonlinesystemdev.azurewebsites.net/
PORTAL_URL=https://districtbusinessportaldev.lacoe.edu/

# One sign-in account per role. All three are the same account until the Update and
# View roles get their own. No passwords: sign-in is Microsoft with phone or passkey.
COS_ADMIN_USER=cp-dahan_david@lacoe.edu
COS_UPDATE_USER=cp-dahan_david@lacoe.edu
COS_VIEW_USER=cp-dahan_david@lacoe.edu

# How long to wait for you to approve the sign-in on your phone.
LOGIN_WAIT_MS=180000

# Optional: open the Edge window on a particular monitor before maximizing it.
# x,y of a point on that monitor, e.g. -1920,0 for a monitor left of the main one.
# BROWSER_WINDOW_POSITION=-1920,0
